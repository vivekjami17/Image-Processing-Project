# Copy to .env for local development (`npm run dev:api` / `npm run dev:worker`).
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://app:app@localhost:5432/images

# "s3" for AWS S3 or any S3-compatible service; "local" stores files on disk (no S3 needed).
STORAGE_DRIVER=s3
S3_BUCKET=images
S3_REGION=us-east-1
# For LocalStack/MinIO. Omit S3_ENDPOINT and S3_PUBLIC_ENDPOINT to use real AWS S3.
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Validation thresholds (defaults shown)
# MIN_FILE_BYTES=10240
# MIN_WIDTH=400
# MIN_HEIGHT=400
# BLUR_THRESHOLD=50
# SIMILARITY_MAX_DISTANCE=8
# FACE_MIN_CONFIDENCE=0.6
# FACE_MIN_HEIGHT_RATIO=0.15

# WORKER_CONCURRENCY=2
